{
  "name": "sp-plugin",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Personal Super Productivity plugin monorepo",
  "packageManager": "pnpm@10.16.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "build:all": "node scripts/build.mjs --all",
    "dev": "node scripts/build.mjs --dev base-ai-bot",
    "release": "node scripts/release.mjs",
    "typecheck": "pnpm -r --no-bail typecheck",
    "clean": "node scripts/build.mjs --clean"
  },
  "devDependencies": {
    "vite": "8.3.4"
  }
}
