{
  "id": "sp_mcp",
  "name": "SP MCP Bridge",
  "version": "0.2.2",
  "manifestVersion": 1,
  "minSupVersion": "19.2.0",
  "description": "Command-file bridge that lets an external MCP/agent process read and change tasks, projects, tags and the timer through the plugin API. Runs from the host plugin, so closing the side panel does not stop it.",
  "icon": "icon.svg",
  "iFrame": true,
  "sidePanel": true,
  "isSkipMenuEntry": true,
  "hooks": ["currentTaskChange", "taskComplete"],
  "nodeScriptConfig": {
    "timeout": 30000,
    "memoryLimit": "64MB"
  },
  "permissions": [
    "getTasks",
    "getArchivedTasks",
    "addTask",
    "updateTask",
    "deleteTask",
    "getAllProjects",
    "addProject",
    "updateProject",
    "deleteProject",
    "getAllTags",
    "addTag",
    "updateTag",
    "reorderTasks",
    "dispatchAction",
    "showSnack",
    "notify",
    "nodeExecution",
    "persistDataSynced",
    "loadSyncedData",
    "registerHook"
  ],
  "allowedHosts": []
}
