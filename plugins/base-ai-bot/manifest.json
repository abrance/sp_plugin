{
  "id": "base-ai-bot",
  "name": "Base AI Bot",
  "version": "1.6.1",
  "manifestVersion": 1,
  "minSupVersion": "19.2.0",
  "description": "OpenAI-compatible AI assistant that manages tasks, projects and tags through natural language chat.",
  "icon": "icon.svg",
  "iFrame": true,
  "sidePanel": true,
  "isSkipMenuEntry": true,
  "hooks": [],
  "permissions": [
    "getTasks",
    "getArchivedTasks",
    "getCurrentContextTasks",
    "addTask",
    "updateTask",
    "deleteTask",
    "getAllProjects",
    "addProject",
    "updateProject",
    "getAllTags",
    "addTag",
    "updateTag",
    "reorderTasks",
    "showSnack",
    "notify",
    "openDialog",
    "persistDataSynced",
    "loadSyncedData",
    "dispatchAction",
    "nodeExecution"
  ]
}
